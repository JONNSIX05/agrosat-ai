# 1. Base de Datos Unificada (PostgreSQL 16 + PostGIS 3.4 + pgvector 0.7)
POSTGRES_USER=agrosat_admin
POSTGRES_PASSWORD=agrosat_secret_2026
POSTGRES_DB=agrosat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
DATABASE_URL=postgresql://agrosat_admin:agrosat_secret_2026@localhost:15432/agrosat_db

# 2. Puertos de Microservicios
GATEWAY_PORT=18080
MS1_PORT=3001
MS2_PORT=3002
MS3_PORT=3003
MS4_PORT=3004
MS5_PORT=3005

# 3. URLs Internas entre Microservicios
MS1_INTERNAL_URL=http://localhost:3001
MS2_INTERNAL_URL=http://localhost:3002
MS3_INTERNAL_URL=http://localhost:3003
MS4_INTERNAL_URL=http://localhost:3004
MS5_INTERNAL_URL=http://localhost:3005

# 4. MS4: Embeddings 100% Locales en Node.js (Cero APIs Externas de Embeddings)
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
TRANSFORMERS_CACHE=./.cache/huggingface

# 5. MS4: Única API Externa de IA — DeepSeek Oficial
DEEPSEEK_API_KEY=sk-reemplazar-con-tu-api-key-de-deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 6. MS5 + n8n + Telegram Bot API Real
N8N_ALERT_WEBHOOK_URL=http://localhost:15678/webhook/agrosat-watermelon-alert
TELEGRAM_BOT_TOKEN=reemplazar-con-token-botfather
TELEGRAM_FARMER_CHAT_ID=reemplazar-con-chat-id-agricultor

# 7. Parcela Semilla por Defecto para Simulador Node-RED (:18880)
DEFAULT_PARCEL_ID=00000000-0000-0000-0000-000000000001
DEFAULT_FARMER_ID=00000000-0000-0000-0000-000000000010
