{
  "name": "agrosat-ai-monorepo",
  "version": "1.0.0",
  "description": "AgroSat AI — Teledetección Satelital Sintética, Zonificación GIS, Telemetría IoT y Agrónomo Virtual RAG para el Cultivo de Sandía",
  "author": "AgroSat AI Architecture Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "build:gateway": "nest build api-gateway",
    "build:ms1": "nest build ms1-satellite-ingestion-service",
    "build:ms2": "nest build ms2-crop-zoning-service",
    "build:ms3": "nest build ms3-agronomic-telemetry-service",
    "build:ms4": "nest build ms4-virtual-agronomist-rag-service",
    "build:ms5": "nest build ms5-alert-notification-service",
    "build:all": "npm run build:ms1 && npm run build:ms2 && npm run build:ms3 && npm run build:ms4 && npm run build:ms5 && npm run build:gateway",
    "start:gateway:dev": "nest start api-gateway --watch",
    "start:ms1:dev": "nest start ms1-satellite-ingestion-service --watch",
    "start:ms2:dev": "nest start ms2-crop-zoning-service --watch",
    "start:ms3:dev": "nest start ms3-agronomic-telemetry-service --watch",
    "start:ms4:dev": "nest start ms4-virtual-agronomist-rag-service --watch",
    "start:ms5:dev": "nest start ms5-alert-notification-service --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.1.2",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "openai": "^4.73.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
